<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CustomGarmentApp.Pages.GarmentSummaryPage"
    Title="Garment Summary"
    BackgroundColor="#0D0D0D">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <Label
                Text="GARMENT SUMMARY"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center" />

            <Border
                BackgroundColor="#222222"
                Stroke="#444444"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="SELECTED GARMENT"
                        TextColor="#AAAAAA"
                        FontSize="13" />

                    <Label
                        x:Name="GarmentNameLabel"
                        Text="No garment selected"
                        TextColor="White"
                        FontSize="24"
                        FontAttributes="Bold" />

                    <Label
                        Text="DESCRIPTION"
                        TextColor="#AAAAAA"
                        FontSize="13" />

                    <Label
                        x:Name="GarmentDescriptionLabel"
                        Text=""
                        TextColor="White"
                        FontSize="16" />

                </VerticalStackLayout>
            </Border>

            <Button
                Text="BACK TO CATALOG"
                Clicked="BackClicked"
                BackgroundColor="White"
                TextColor="Black" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
