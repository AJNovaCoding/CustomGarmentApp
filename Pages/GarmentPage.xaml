<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CustomGarmentApp.Pages.GarmentPage"
    Title="Garment Catalog"
    BackgroundColor="#0D0D0D"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <!-- Store heading -->
            <Label
                Text="CUSTOM GARMENT"
                FontSize="28"
                FontAttributes="Bold"
                CharacterSpacing="3"
                TextColor="White"
                HorizontalOptions="Center" />

            <Label
                Text="SELECT YOUR GARMENT"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#B0B0B0"
                HorizontalOptions="Center" />

            <!-- Search functionality -->
            <Entry
                x:Name="SearchEntry"
                Placeholder="Search garments (e.g. dress*)"
                TextColor="White"
                PlaceholderColor="#888888"
                BackgroundColor="#222222"
                HeightRequest="55" />

            <HorizontalStackLayout Spacing="10">
                <Button
                    Text="SEARCH"
                    Clicked="SearchClicked"
                    BackgroundColor="White"
                    TextColor="Black"
                    HorizontalOptions="Fill"
                    WidthRequest="150" />

                <Button
                    Text="CLEAR"
                    Clicked="ClearClicked"
                    BackgroundColor="#333333"
                    TextColor="White"
                    WidthRequest="100" />
            </HorizontalStackLayout>

            <!-- Search feedback -->
            <Label
                x:Name="ResultsLabel"
                Text="Showing all 3 garments"
                TextColor="#B0B0B0"
                FontSize="14" />

            <!-- Garment 1 -->
            <Border
                x:Name="JacketCard"
                BackgroundColor="#222222"
                Padding="20"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="CUSTOM JACKET"
                        FontSize="20"
                        TextColor="White"
                        FontAttributes="Bold" />

                    <Label
                        Text="Personalize a jacket with colors, fabrics, and accessories."
                        TextColor="#B0B0B0" />

                    <Button
                        Text="CUSTOMIZE"
                        BackgroundColor="White"
                        TextColor="Black" />
                </VerticalStackLayout>
            </Border>

            <!-- Garment 2 -->
            <Border
                x:Name="DressCard"
                BackgroundColor="#222222"
                Padding="20"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="CUSTOM DRESS"
                        FontSize="20"
                        TextColor="White"
                        FontAttributes="Bold" />

                    <Label
                        Text="Create a personalized dress with unique design options."
                        TextColor="#B0B0B0" />

                    <Button
                        Text="CUSTOMIZE"
                        BackgroundColor="White"
                        TextColor="Black" />
                </VerticalStackLayout>
            </Border>

            <!-- Garment 3 -->
            <Border
                x:Name="SkirtCard"
                BackgroundColor="#222222"
                Padding="20"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="10">
                    <Label
                        Text="CUSTOM SKIRT"
                        FontSize="20"
                        TextColor="White"
                        FontAttributes="Bold" />

                    <Label
                        Text="Choose your preferred style, fabric, and embellishments."
                        TextColor="#B0B0B0" />

                    <Button
                        Text="CUSTOMIZE"
                        BackgroundColor="White"
                        TextColor="Black" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

