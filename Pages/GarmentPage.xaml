<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CustomGarmentApp.Pages.GarmentPage"
    Title="Garment Catalog"
    BackgroundColor="#0D0D0D"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="15">

            <!-- Application heading -->
            <Label
                Text="CUSTOM GARMENT"
                FontSize="28"
                FontAttributes="Bold"
                CharacterSpacing="3"
                TextColor="White"
                HorizontalOptions="Center" />

            <!-- Allows the current user to sign out. -->
            <Button
               Text="LOG OUT"
               Clicked="LogoutClicked"
               BackgroundColor="#333333"
               TextColor="White"
               HorizontalOptions="End"
               Padding="20,10" />


            <Label
                Text="MANAGE GARMENTS"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="#B0B0B0"
                HorizontalOptions="Center" />

            <!-- Search instructions -->
            <Label
                Text="Search by garment name. Use * for wildcards."
                TextColor="#B0B0B0"
                FontSize="13" />

            <!-- Search field -->
            <Entry
                x:Name="SearchEntry"
                Placeholder="Search garments..."
                TextColor="White"
                PlaceholderColor="#888888"
                BackgroundColor="#222222"
                HeightRequest="55" />

            <HorizontalStackLayout Spacing="10">
                <Button
                    Text="SEARCH"
                    Clicked="SearchClicked"
                    BackgroundColor="White"
                    TextColor="Black" />

                <Button
                    Text="CLEAR"
                    Clicked="ClearClicked"
                    BackgroundColor="#333333"
                    TextColor="White" />
            </HorizontalStackLayout>

            <!-- Add garment form -->
            <Label
                Text="ADD OR EDIT GARMENT"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="18"
                Margin="0,15,0,0" />

            <Entry
                x:Name="NameEntry"
                Placeholder="Garment Name"
                TextColor="White"
                PlaceholderColor="#888888"
                BackgroundColor="#222222" />

            <Entry
                x:Name="DescriptionEntry"
                Placeholder="Garment Description"
                TextColor="White"
                PlaceholderColor="#888888"
                BackgroundColor="#222222" />

            <Button
                x:Name="SaveButton"
                Text="ADD GARMENT"
                Clicked="SaveClicked"
                BackgroundColor="White"
                TextColor="Black" />

            <Button
                Text="CANCEL EDIT"
                Clicked="CancelClicked"
                BackgroundColor="#333333"
                TextColor="White" />

            <!-- Search results -->
            <Label
                x:Name="ResultsLabel"
                Text="Loading garments..."
                TextColor="#B0B0B0" />

            <!-- Dynamic garment records -->
            <VerticalStackLayout
                x:Name="GarmentList"
                Spacing="15" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


